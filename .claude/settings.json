{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm knip*)",
      "Bash(pnpm exec turbo run *)",
      "Bash(pnpm --filter web *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "enabledPlugins": {
    "conventions@claude-conventions": true
  },
  "extraKnownMarketplaces": {
    "claude-conventions": {
      "source": {
        "source": "github",
        "repo": "Azurioh/claude-conventions"
      }
    }
  }
}
