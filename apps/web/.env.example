# App-wide (shared/server/config/env.ts)
# Minimum log level: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Feature greeting (greetingEnv in src/features/greeting/server.ts)
# Number of recent greetings returned by greeting.listRecent. Required, integer 1–100.
GREETING_HISTORY_LIMIT=10
