{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Architecture rules (ADR 0010): ARCH-* ids and scopes live in the published preset.
  "extends": ["@azurioh/arch-rules/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/CHANGELOG.md",
      "!!.specify",
      "!!.claude",
      "!!specs",
      "!!pnpm-lock.yaml",
      // Generated from CLAUDE.md and .claude/rules by the conventions plugin.
      "!!AGENTS.md",
      "!!**/routeTree.gen.ts",
      "!!packages/arch-rules/dist",
      "!!.claude/rules/arch-rules"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
