{
  "name": "tanstack-monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "turbo run lint typecheck test knip",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepare": "lefthook install"
  }
}
