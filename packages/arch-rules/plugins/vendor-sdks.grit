language js

// ARCH-VENDOR: vendor SDKs live only in a feature's server/infrastructure/ and in
// src/shared/server/adapters/ (scope set in biome.jsonc `plugins`).
// This regex is the single vendor list: add a package here when an adapter starts using it.
or {
  `import $clause from $source`,
  `import $source`,
  `export * from $source`,
  `export * as $namespace from $source`,
  `export { $names } from $source`,
  `export type { $names } from $source`
} as $statement where {
  $source <: r"['\"](?:@aws-sdk/[^'\"]+|@google-cloud/[^'\"]+|@azure/[^'\"]+|@prisma/client|drizzle-orm|pg|postgres|mysql2|mongodb|ioredis|redis|stripe|resend|nodemailer)(?:/[^'\"]*)?['\"]",
  register_diagnostic(span=$statement, message="ARCH-VENDOR: vendor SDKs are imported only in server/infrastructure/ or shared/server/adapters/.", severity="error")
}
