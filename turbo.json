{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint": {},
    "//#typecheck": {
      "inputs": ["$TURBO_ROOT$/*.ts", "$TURBO_ROOT$/tsconfig.json"]
    },
    "//#knip": {}
  }
}
