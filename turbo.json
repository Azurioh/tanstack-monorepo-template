{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.jsonc", "$TURBO_ROOT$/pnpm-lock.yaml"]
    },
    "@azurioh/arch-rules#test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "preset.jsonc",
        "biome-manifest.jsonc",
        "plugins/**",
        "rules/**"
      ]
    },
    "//#lint": {},
    "//#typecheck": {
      "inputs": ["$TURBO_ROOT$/*.ts", "$TURBO_ROOT$/tsconfig.json"]
    },
    "//#knip": {}
  }
}
